<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lexis.Desktop.App.ViewModels.Documents"
             x:Class="Lexis.Desktop.App.Views.Documents.DashboardDocumentView"
             x:DataType="vm:DashboardDocumentViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="#141018"/>
      <Setter Property="Foreground" Value="#A89BA3"/>
      <Setter Property="BorderBrush" Value="#2A2530"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="#2A1E24"/>
      <Setter Property="Foreground" Value="#D4A8B0"/>
      <Setter Property="BorderBrush" Value="#D4A8B0"/>
    </Style>
    <Style Selector="TextBlock.hh">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#D4A8B0"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="TextBlock.kpi">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#F3ECEF"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#6A6068"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Background="#100E14">
    <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#2A2530" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Width="8" Height="8" Fill="#D4A8B0" VerticalAlignment="Center"/>
          <TextBlock Text="Riepilogo conto" FontSize="18" FontWeight="SemiBold" Foreground="#F3ECEF"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8A7F88" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="560"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Reload" Command="{Binding ReloadCommand}" Padding="12,5"/>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,14" Spacing="14">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="hh" Text="PATRIMONIO NETTO"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="€" FontSize="22" Foreground="#8A7F88" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding EquityLabel}" FontSize="36" FontWeight="Bold" Foreground="#F3ECEF"
                         FontFamily="Consolas,Courier New,monospace"/>
            </StackPanel>
            <TextBlock Text="{Binding DeltaLabel}" FontSize="13" Foreground="{Binding DeltaBrush}" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
              <TextBlock FontSize="11" Foreground="#8A7F88">
                <Run Text="Conto "/><Run Text="{Binding AccountNumber}" FontWeight="Bold" Foreground="#F3ECEF"/>
              </TextBlock>
              <Border Padding="8,3" Background="#2A1E24" BorderBrush="#D4A8B0" BorderThickness="1">
                <TextBlock Text="{Binding BadgeLabel}" FontSize="10" Foreground="#D4A8B0" FontWeight="Bold"/>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="#D4A8B0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProviderShort}" FontSize="11" Foreground="#8A7F88"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="8" MinWidth="280">
            <StackPanel Orientation="Horizontal">
              <Button Classes="seg" Classes.on="{Binding IsDemo}" Content="Demo" Command="{Binding SetAccountCommand}" CommandParameter="demo"/>
              <Button Classes="seg" Classes.on="{Binding IsReal}" Content="Reale" Command="{Binding SetAccountCommand}" CommandParameter="real"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="hh" Text="FONTE DATI"/>
              <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="hh" Text="BROKER"/>
              <ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Background="#141018" BorderBrush="#2A2530" BorderThickness="1" Padding="12,10">
          <UniformGrid Columns="5">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="hh" Text="P&amp;L APERTO"/>
              <TextBlock Classes="kpi" Text="{Binding OpenPlLabel}" Foreground="{Binding OpenPlBrush}"/>
              <TextBlock Classes="hint" Text="{Binding OpenPlSub}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="hh" Text="P&amp;L TOTALE"/>
              <TextBlock Classes="kpi" Text="{Binding TotalPlLabel}" Foreground="{Binding TotalPlBrush}"/>
              <TextBlock Classes="hint" Text="{Binding TotalPlSub}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="hh" Text="WIN RATE"/>
              <TextBlock Classes="kpi" Text="{Binding WinRateLabel}" Foreground="{Binding WinBrush}"/>
              <TextBlock Classes="hint" Text="{Binding WinRateSub}"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Classes="hh" Text="LIQUIDITÀ"/>
              <TextBlock Classes="kpi" Text="{Binding CashLabel}"/>
              <TextBlock Classes="hint" Text="disponibile"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="hh" Text="MARGINE LIBERO"/>
              <TextBlock Classes="kpi" Text="{Binding FreeMarginLabel}"/>
              <TextBlock Classes="hint" Text="{Binding MarginSub}"/>
            </StackPanel>
          </UniformGrid>
        </Border>

        <Border Background="#141018" BorderBrush="#2A2530" BorderThickness="1" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Andamento equity" FontSize="14" FontWeight="SemiBold" Foreground="#F3ECEF"/>
                <TextBlock Text="{Binding ChartSub}" FontSize="11" Foreground="{Binding ChartBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Classes="seg" Classes.on="{Binding Range1G}" Content="1G" Command="{Binding SetRangeCommand}" CommandParameter="1G"/>
                <Button Classes="seg" Classes.on="{Binding Range1S}" Content="1S" Command="{Binding SetRangeCommand}" CommandParameter="1S"/>
                <Button Classes="seg" Classes.on="{Binding Range1M}" Content="1M" Command="{Binding SetRangeCommand}" CommandParameter="1M"/>
                <Button Classes="seg" Classes.on="{Binding RangeYtd}" Content="YTD" Command="{Binding SetRangeCommand}" CommandParameter="YTD"/>
              </StackPanel>
            </Grid>
            <Border Height="150" Background="#0A080C" BorderBrush="#1A1620" BorderThickness="1" ClipToBounds="True">
              <Viewbox Stretch="Fill">
                <Canvas Width="640" Height="140">
                  <Path Data="{Binding EquityPath}" Stroke="{Binding ChartBrush}" StrokeThickness="2.5"/>
                </Canvas>
              </Viewbox>
            </Border>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*">
          <Border Background="#141018" BorderBrush="#2A2530" BorderThickness="1" Padding="14" Margin="0,0,6,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Esposizione Call / Put" FontSize="14" FontWeight="SemiBold" Foreground="#F3ECEF"/>
              <StackPanel Orientation="Horizontal" Height="12">
                <Border Width="{Binding CallBarWidth}" Background="#9922C55E" MinWidth="4"/>
                <Border Width="{Binding PutBarWidth}" Background="#99EF4444" MinWidth="4"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="8" Height="8" Background="#00FF7A" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding CallLabel}" FontSize="11" Foreground="#A89BA3"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                  <Border Width="8" Height="8" Background="#FF3B5C" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding PutLabel}" FontSize="11" Foreground="#A89BA3"/>
                </StackPanel>
              </Grid>
              <UniformGrid Columns="3" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Classes="hh" Text="APERTE"/>
                  <TextBlock Classes="kpi" Text="{Binding OpenCountLabel}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="hh" Text="OPZIONI"/>
                  <TextBlock Classes="kpi" Text="{Binding OptionsValueLabel}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="hh" Text="P&amp;L"/>
                  <TextBlock Classes="kpi" Text="{Binding ExposurePlLabel}" Foreground="{Binding ExposurePlBrush}"/>
                </StackPanel>
              </UniformGrid>
              <Button Content="Apri Portafoglio →" Command="{Binding OpenPortfolioCommand}"
                      HorizontalAlignment="Left" Padding="12,6" Margin="0,6,0,0"
                      Background="#1A1520" Foreground="#D4A8B0" BorderBrush="#3A2A32" BorderThickness="1"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="#141018" BorderBrush="#2A2530" BorderThickness="1" Padding="14" Margin="6,0,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="Attività recente" FontSize="14" FontWeight="SemiBold" Foreground="#F3ECEF"/>
              <Grid ColumnDefinitions="*,70,40,70,50" Margin="0,0,0,4">
                <TextBlock Classes="hh" Text="STRUMENTO"/>
                <TextBlock Grid.Column="1" Classes="hh" Text="LATO"/>
                <TextBlock Grid.Column="2" Classes="hh" Text="QTY"/>
                <TextBlock Grid.Column="3" Classes="hh" Text="P&amp;L" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Classes="hh" Text="ORA" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentTrades}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,70,40,70,50" Height="28">
                      <TextBlock Text="{Binding Instrument}" FontFamily="Consolas,Courier New,monospace"
                                 FontSize="12" Foreground="#E8DFE4" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Side}" FontSize="11" FontWeight="Bold"
                                 Foreground="{Binding SideBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding QtyLabel}" FontSize="12" Foreground="#A89BA3" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding PlLabel}" FontFamily="Consolas,Courier New,monospace"
                                 FontSize="12" Foreground="{Binding PlBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="11" Foreground="#6A6068"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Apri Mentor →" Command="{Binding OpenMentorCommand}"
                      HorizontalAlignment="Left" Padding="12,6" Margin="0,6,0,0"
                      Background="#1A1520" Foreground="#D4A8B0" BorderBrush="#3A2A32" BorderThickness="1"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
