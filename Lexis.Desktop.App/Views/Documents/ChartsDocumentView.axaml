<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lexis.Desktop.App.ViewModels.Documents"
             x:Class="Lexis.Desktop.App.Views.Documents.ChartsDocumentView"
             x:DataType="vm:ChartsDocumentViewModel"
             x:CompileBindings="False">
  <DockPanel Background="#0A0E17">
    <Border DockPanel.Dock="Top"
            Padding="10,8"
            Background="#12151F"
            BorderBrush="#252A38"
            BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="GRAFICI"
                     FontSize="11"
                     FontWeight="Bold"
                     LetterSpacing="1.2"
                     Foreground="#D4A8B0"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Symbol" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" />
            <ComboBox Width="96" ItemsSource="{Binding SymbolOptions}" SelectedItem="{Binding SelectedSymbol}" FontSize="12" />

            <TextBlock Text="TF" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
            <ComboBox Width="72" ItemsSource="{Binding TimeframeOptions}" SelectedItem="{Binding SelectedTimeframe}" FontSize="12" />

            <TextBlock Text="Tipo" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
            <ComboBox Width="110" ItemsSource="{Binding ChartTypeOptions}" SelectedItem="{Binding SelectedChartType}" FontSize="12" />

            <TextBlock Text="Barre" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
            <NumericUpDown Width="84" Minimum="40" Maximum="800" Increment="20" Value="{Binding CandleCount}" FontSize="12" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Indicatori" Command="{Binding ToggleIndicatorsCommand}"
                    Padding="10,5" Background="#1A1520" Foreground="#D4A8B0"
                    BorderBrush="#3A2A32" BorderThickness="1" />
            <Button Content="Ricarica" Command="{Binding ReloadCommand}"
                    Padding="10,5" Background="#1A1520" Foreground="#D4A8B0"
                    BorderBrush="#3A2A32" BorderThickness="1" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,8"
                Background="#0F172A" CornerRadius="4"
                IsVisible="{Binding IndicatorsOpen}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <CheckBox Content="Volume" IsChecked="{Binding ShowVolume}" Foreground="#E2E8F0" />
            <CheckBox Content="EMA 9" IsChecked="{Binding ShowEma}" Foreground="#E2E8F0" />
            <CheckBox Content="SMA 20" IsChecked="{Binding ShowSma}" Foreground="#E2E8F0" />
            <CheckBox Content="Bollinger" IsChecked="{Binding ShowBollinger}" Foreground="#E2E8F0" />
            <CheckBox Content="VWAP" IsChecked="{Binding ShowVwap}" Foreground="#E2E8F0" />
            <CheckBox Content="RSI" IsChecked="{Binding ShowRsi}" Foreground="#E2E8F0" />
            <CheckBox Content="MACD" IsChecked="{Binding ShowMacd}" Foreground="#E2E8F0" />
            <CheckBox Content="ATR" IsChecked="{Binding ShowAtr}" Foreground="#E2E8F0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="#12151F" BorderBrush="#252A38" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding OhlcReadout}" FontFamily="Consolas,Courier New,monospace"
                   FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                   Foreground="#8B8FA3" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <Panel x:Name="ChartHost" Background="#0A0E17" />
  </DockPanel>
</UserControl>
