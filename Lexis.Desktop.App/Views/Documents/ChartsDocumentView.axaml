<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lexis.Desktop.App.ViewModels.Documents"
             x:Class="Lexis.Desktop.App.Views.Documents.ChartsDocumentView"
             x:DataType="vm:ChartsDocumentViewModel">
  <DockPanel Background="#0A0E17">
    <Border DockPanel.Dock="Top"
            Padding="12,10"
            Background="#12151F"
            BorderBrush="#252A38"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Text="GRAFICI"
                   FontSize="11"
                   FontWeight="Bold"
                   LetterSpacing="1.2"
                   Foreground="#D4A8B0"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Symbol" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" />
          <ComboBox Width="100"
                    ItemsSource="{Binding SymbolOptions}"
                    SelectedItem="{Binding SelectedSymbol}"
                    FontSize="12" />
          <TextBlock Text="Candele" Foreground="#8B8FA3" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
          <NumericUpDown Width="90"
                         Minimum="20"
                         Maximum="500"
                         Increment="20"
                         Value="{Binding CandleCount}"
                         FontSize="12" />
        </StackPanel>

        <Button Grid.Column="2"
                Content="Ricarica"
                Command="{Binding ReloadCommand}"
                Padding="12,6"
                Margin="8,0,0,0"
                Background="#1A1520"
                Foreground="#D4A8B0"
                BorderBrush="#3A2A32"
                BorderThickness="1" />

        <TextBlock Grid.Column="3"
                   Text="{Binding StatusText}"
                   Margin="16,0,0,0"
                   FontSize="11"
                   Foreground="#8B8FA3"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Panel x:Name="ChartHost" Background="#0A0E17" />
  </DockPanel>
</UserControl>
