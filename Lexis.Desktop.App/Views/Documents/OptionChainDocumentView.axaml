<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lexis.Desktop.App.ViewModels.Documents"
             xmlns:row="using:Lexis.Desktop.App.ViewModels"
             xmlns:conv="using:Lexis.Desktop.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Lexis.Desktop.App.Views.Documents.OptionChainDocumentView"
             x:Name="Root"
             x:DataType="vm:OptionChainDocumentViewModel"
             x:CompileBindings="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <UserControl.Styles>
    <Style Selector="Button.quote">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.quote.ask">
      <Setter Property="Foreground" Value="#00FF7A"/>
    </Style>
    <Style Selector="Button.quote.bid">
      <Setter Property="Foreground" Value="#FF3B5C"/>
    </Style>
    <Style Selector="Button.quote:pointerover">
      <Setter Property="Background" Value="#243044"/>
    </Style>
    <Style Selector="TextBlock.hdr">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="4,6"/>
      <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="2,2"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="{Binding RowBackground}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="10" LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Padding="12,10"
            Background="#111827"
            CornerRadius="6"
            Margin="0,0,0,8"
            HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Symbol" Classes="hdr" VerticalAlignment="Center"/>
            <DropDownButton Content="{Binding SelectedSymbol}" MinWidth="100" Padding="10,4">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Width="120"
                           ItemsSource="{Binding SymbolOptions}"
                           SelectedItem="{Binding SelectedSymbol}"
                           SelectionMode="Single"/>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock Text="Expiry" Classes="hdr" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <DropDownButton Content="{Binding SelectedExpiryOption}" MinWidth="160" Padding="10,4">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Width="200" MaxHeight="220"
                           ItemsSource="{Binding ExpiryOptions}"
                           SelectedItem="{Binding SelectedExpiryOption}"
                           SelectionMode="Single"/>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <Button Content="Load" Command="{Binding ApplyUnderlyingExpiryCommand}"/>

            <TextBlock Text="Strikes" Classes="hdr" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <DropDownButton Content="{Binding SelectedStrikeCountOption}" MinWidth="56" Padding="10,4">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Width="72"
                           ItemsSource="{Binding StrikeCountOptions}"
                           SelectedItem="{Binding SelectedStrikeCountOption}"
                           SelectionMode="Single"/>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock Text="{Binding SpotHud}" FontSize="18" FontWeight="SemiBold"
                       Foreground="#F8FAFC" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding ExpiryHud}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LiveHud}" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="Layout" Command="{Binding ToggleColumnsCommand}"/>
            <Button Content="Start live" Command="{Binding StartLiveCommand}" IsEnabled="{Binding !IsLive}"/>
            <Button Content="Stop" Command="{Binding StopLiveCommand}" IsEnabled="{Binding IsLive}"/>
            <Button Content="Follow IPC" Command="{Binding ToggleIpcFollowCommand}"/>
            <Button Content="Reload" Command="{Binding ReloadCommand}"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8"
                Background="#0F172A" CornerRadius="4"
                IsVisible="{Binding ColumnsOpen}"
                HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="Columns" Classes="hdr" VerticalAlignment="Center"/>
              <CheckBox Content="IV" IsChecked="{Binding ShowIv}"/>
              <CheckBox Content="Δ" IsChecked="{Binding ShowDelta}"/>
              <CheckBox Content="Γ" IsChecked="{Binding ShowGamma}"/>
              <CheckBox Content="Θ" IsChecked="{Binding ShowTheta}"/>
              <CheckBox Content="Vega" IsChecked="{Binding ShowVega}"/>
              <CheckBox Content="Vol" IsChecked="{Binding ShowVol}"/>
              <CheckBox Content="OI" IsChecked="{Binding ShowOi}"/>
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="Ask = BUY · Bid = SELL (Thinkorswim)"
                       Foreground="#64748B" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Padding="12,10"
            Background="#111827"
            CornerRadius="6"
            Margin="0,8,0,0"
            IsVisible="{Binding TicketOpen}">
      <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding TicketHeadline}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <TextBlock Text="Qty" Classes="hdr" VerticalAlignment="Center"/>
          <NumericUpDown Width="90" Minimum="1" Maximum="500" Increment="1"
                         Value="{Binding TicketQty}"/>
          <Button Content="+1" Command="{Binding AddQtyCommand}"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ItemsSource="{Binding Legs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1E293B" CornerRadius="4" Padding="10,7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                          Background="{Binding Side, Converter={x:Static conv:SideAccentConverter.Instance}}">
                    <TextBlock Text="{Binding Side}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                  </Border>
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                             FontFamily="Consolas,Courier New,monospace" FontSize="13" Foreground="#E2E8F0"
                             Text="{Binding SummaryLine}"/>
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12"
                             Text="{Binding Notional, StringFormat='${0:N0}'}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                   Foreground="#94A3B8" FontSize="12"
                   Text="{Binding TicketFooter}"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Right">
          <Button Content="Remove last leg" Command="{Binding RemoveLastLegCommand}"/>
          <Button Content="Clear" Command="{Binding ClearLegsCommand}"/>
          <Button Content="Confirm (mock)" Command="{Binding ConfirmTicketCommand}"/>
          <Button Content="Cancel" Command="{Binding CancelTicketCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Background="#0B1220" CornerRadius="6" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="10,8,10,2" ColumnDefinitions="*,110,*">
          <TextBlock Text="CALLS" Foreground="#00FF7A" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Column="1" Background="#152238" CornerRadius="3" Padding="4,2" Margin="4,0">
            <TextBlock Text="STRIKE" Foreground="#93C5FD" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Grid.Column="2" Text="PUTS" Foreground="#FF3B5C" FontWeight="Bold" FontSize="12"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <DataGrid x:Name="ChainGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  Background="#0B1220"
                  Foreground="#E2E8F0"
                  BorderThickness="0"
                  RowHeight="32"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <!-- Fixed pixel widths: star sizing crushed headers/strike when many columns were on -->
            <DataGridTextColumn Header="OI" Binding="{Binding CallOi}" Width="56" MinWidth="52"/>
            <DataGridTextColumn Header="Vol" Binding="{Binding CallVol}" Width="52" MinWidth="48"/>
            <DataGridTextColumn Header="Vega" Binding="{Binding CallVega, StringFormat=F2}" Width="56" MinWidth="52"/>
            <DataGridTextColumn Header="Θ" Binding="{Binding CallTheta, StringFormat=F2}" Width="52" MinWidth="48"/>
            <DataGridTextColumn Header="Γ" Binding="{Binding CallGamma, StringFormat=F4}" Width="60" MinWidth="56"/>
            <DataGridTextColumn Header="Δ" Binding="{Binding CallDelta, StringFormat=F3}" Width="56" MinWidth="52"/>
            <DataGridTextColumn Header="IV" Binding="{Binding CallIv, StringFormat=F1}" Width="52" MinWidth="48"/>

            <DataGridTemplateColumn Header="Bid" Width="72" MinWidth="68">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Classes="quote bid"
                          Content="{Binding CallBid, StringFormat=F2}"
                          Command="{Binding ClickCallBidCommand}"
                          ToolTip.Tip="SELL call"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ask" Width="72" MinWidth="68">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Classes="quote ask"
                          Content="{Binding CallAsk, StringFormat=F2}"
                          Command="{Binding ClickCallAskCommand}"
                          ToolTip.Tip="BUY call"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Strike" Width="110" MinWidth="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="#152238" Padding="6,0" ClipToBounds="True">
                    <TextBlock Text="{Binding Strike, StringFormat=F1}"
                               FontWeight="Bold"
                               FontSize="13"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="#E0F2FE"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Bid" Width="72" MinWidth="68">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Classes="quote bid"
                          Content="{Binding PutBid, StringFormat=F2}"
                          Command="{Binding ClickPutBidCommand}"
                          ToolTip.Tip="SELL put"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ask" Width="72" MinWidth="68">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Classes="quote ask"
                          Content="{Binding PutAsk, StringFormat=F2}"
                          Command="{Binding ClickPutAskCommand}"
                          ToolTip.Tip="BUY put"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="IV" Binding="{Binding PutIv, StringFormat=F1}" Width="52" MinWidth="48"/>
            <DataGridTextColumn Header="Δ" Binding="{Binding PutDelta, StringFormat=F3}" Width="56" MinWidth="52"/>
            <DataGridTextColumn Header="Γ" Binding="{Binding PutGamma, StringFormat=F4}" Width="60" MinWidth="56"/>
            <DataGridTextColumn Header="Θ" Binding="{Binding PutTheta, StringFormat=F2}" Width="52" MinWidth="48"/>
            <DataGridTextColumn Header="Vega" Binding="{Binding PutVega, StringFormat=F2}" Width="56" MinWidth="52"/>
            <DataGridTextColumn Header="Vol" Binding="{Binding PutVol}" Width="52" MinWidth="48"/>
            <DataGridTextColumn Header="OI" Binding="{Binding PutOi}" Width="56" MinWidth="52"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
