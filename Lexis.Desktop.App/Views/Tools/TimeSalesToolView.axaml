<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lexis.Desktop.App.ViewModels.Tools"
             x:Class="Lexis.Desktop.App.Views.Tools.TimeSalesToolView"
             x:DataType="vm:TimeSalesToolViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="#141018"/>
      <Setter Property="Foreground" Value="#A89BA3"/>
      <Setter Property="BorderBrush" Value="#2A2530"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="#2A1E24"/>
      <Setter Property="Foreground" Value="#D4A8B0"/>
      <Setter Property="BorderBrush" Value="#D4A8B0"/>
    </Style>
    <Style Selector="TextBlock.hh">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#D4A8B0"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Background="#100E14">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#2A2530" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="TIME &amp; SALES" FontSize="16" FontWeight="SemiBold" Foreground="#F3ECEF"/>
          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8A7F88" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="160"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding LiveBadge}" Command="{Binding TogglePauseCommand}"
                Padding="10,4" Background="#1A1520" Foreground="#D4A8B0" BorderBrush="#3A2A32" BorderThickness="1"/>
      </Grid>
    </Border>

    <!-- Symbols -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#2A2530" BorderThickness="0,0,0,1" Background="#141018">
      <WrapPanel ItemHeight="32">
        <Button Classes="seg" Content="SPY" Command="{Binding SetSymbolCommand}" CommandParameter="SPY"/>
        <Button Classes="seg" Content="QQQ" Command="{Binding SetSymbolCommand}" CommandParameter="QQQ"/>
        <Button Classes="seg" Content="AAPL" Command="{Binding SetSymbolCommand}" CommandParameter="AAPL"/>
        <Button Classes="seg" Content="TSLA" Command="{Binding SetSymbolCommand}" CommandParameter="TSLA"/>
        <Button Classes="seg" Content="ES" Command="{Binding SetSymbolCommand}" CommandParameter="ES"/>
        <Button Classes="seg" Content="SPX" Command="{Binding SetSymbolCommand}" CommandParameter="SPX"/>
      </WrapPanel>
    </Border>

    <!-- Filters -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#2A2530" BorderThickness="0,0,0,1" Background="#141018">
      <WrapPanel ItemHeight="32">
        <TextBlock Text="MIN SIZE" Classes="hh" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Button Classes="seg" Classes.on="{Binding Min0}" Content="All" Command="{Binding SetMinSizeCommand}" CommandParameter="0"/>
        <Button Classes="seg" Classes.on="{Binding Min10}" Content="≥10" Command="{Binding SetMinSizeCommand}" CommandParameter="10"/>
        <Button Classes="seg" Classes.on="{Binding Min50}" Content="≥50" Command="{Binding SetMinSizeCommand}" CommandParameter="50"/>
        <Button Classes="seg" Classes.on="{Binding Min100}" Content="≥100" Command="{Binding SetMinSizeCommand}" CommandParameter="100"/>
        <Button Classes="seg" Classes.on="{Binding BlocksOnly}" Content="{Binding BlockThreshLabel}"
                Command="{Binding ToggleBlocksOnlyCommand}" Margin="8,0,0,0"/>
      </WrapPanel>
    </Border>

    <!-- KPI strip (stacked, no overlap) -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#2A2530" BorderThickness="0,0,0,1" Background="#121014">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="64,*">
          <TextBlock Classes="hh" Text="BUY" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding BuyVolLabel}" Classes="cell" Foreground="#00FF7A" FontWeight="Bold"/>
        </Grid>
        <Grid ColumnDefinitions="64,*">
          <TextBlock Classes="hh" Text="SELL" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding SellVolLabel}" Classes="cell" Foreground="#FF3B5C" FontWeight="Bold"/>
        </Grid>
        <Grid ColumnDefinitions="64,*">
          <TextBlock Classes="hh" Text="DELTA" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding DeltaLabel}" Classes="cell" Foreground="{Binding DeltaBrush}" FontWeight="Bold"/>
        </Grid>
        <Grid ColumnDefinitions="64,*">
          <TextBlock Classes="hh" Text="PRINTS" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding PrintsLabel}" Classes="cell" Foreground="#F3ECEF" FontWeight="Bold"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Column headers: TIME | TICKER | PRICE | VOLUME -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#141018" BorderBrush="#2A2530" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,*,*,*">
        <TextBlock Classes="hh" Text="TIME"/>
        <TextBlock Grid.Column="1" Classes="hh" Text="TICKER"/>
        <TextBlock Grid.Column="2" Classes="hh" Text="PRICE" TextAlignment="Right"/>
        <TextBlock Grid.Column="3" Classes="hh" Text="VOLUME" TextAlignment="Right"/>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Margin="10,6" FontSize="10" Foreground="#6A6068"
               Text="Verde = buy (ASK) · Rosso = sell (BID) · orario locale del print"/>

    <!-- Tape rows -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#100E14">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding RowBg}" BorderBrush="#1A1620" BorderThickness="0,0,0,1" Height="28" Padding="10,0">
              <Grid ColumnDefinitions="*,*,*,*">
                <TextBlock Classes="cell" Text="{Binding Time}" Foreground="#F3ECEF" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Ticker}" Foreground="#F3ECEF" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Price}" TextAlignment="Right"
                           FontWeight="Bold" Foreground="{Binding Accent}"/>
                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Size}" TextAlignment="Right"
                           FontWeight="Bold" Foreground="{Binding SizeFg}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
